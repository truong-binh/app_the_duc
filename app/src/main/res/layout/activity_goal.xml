<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="@color/background_dark">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="Mục tiêu cá nhân"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="22sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/edtStepGoal"
            android:hint="Bước/ngày (ví dụ 8000)"
            android:inputType="number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/accent_red"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:padding="16dp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/edtCalGoal"
            android:hint="Calories/ngày (tùy chọn)"
            android:inputType="number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/accent_red"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:padding="16dp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/edtStart"
            android:hint="Ngày bắt đầu (yyyy-MM-dd)"
            android:inputType="date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/accent_red"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:padding="16dp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/edtEnd"
            android:hint="Ngày kết thúc (yyyy-MM-dd)"
            android:inputType="date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/accent_red"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:padding="16dp"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnSaveGoal"
            android:text="Lưu mục tiêu"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/accent_red"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

</ScrollView>


